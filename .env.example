# Copia este archivo como .env.local y completa los valores.
# Todo es opcional en tu computadora: sin estas variables la tienda funciona en modo local
# (base de datos en .data/, WhatsApp simulado y bot con menú básico).

# ---------- Negocio (se ven en la tienda) ----------
NEXT_PUBLIC_STORE_NAME=AURUM
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp del negocio, internacional y sin "+" (ej. 51987654321)
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999
NEXT_PUBLIC_YAPE_HOLDER=AURUM Perfumes
NEXT_PUBLIC_YAPE_NUMBER=999 999 999
NEXT_PUBLIC_PLIN_HOLDER=AURUM Perfumes
NEXT_PUBLIC_PLIN_NUMBER=999 999 999
NEXT_PUBLIC_PICKUP_ADDRESS=Av. Ejemplo 123, Miraflores, Lima

# ---------- Panel admin (obligatorio en producción) ----------
# Correo para entrar al panel (opcional: sin él, basta la contraseña)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ caracteres al azar. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Base de datos y archivos: Supabase (obligatorio en producción) ----------
# Connection string del pooler (Project Settings → Database → Connection pooling, modo Transaction, puerto 6543)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de tu app de Meta: valida que los mensajes vengan de Meta
WHATSAPP_APP_SECRET=
# Texto que tú inventas y pegas también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=es
# Tu WhatsApp personal: recibe avisos de pedidos, comprobantes y stock bajo
OWNER_WHATSAPP=

# ---------- Bot con IA (Claude) ----------
ANTHROPIC_API_KEY=
# Opcional: otro modelo (por defecto claude-opus-5-5) o "off" para usar solo el menú
BOT_MODEL=
BOT_AI=

# ---------- Cron de automatizaciones ----------
# Vercel lo envía solo; si usas otro cron, mándalo como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ---------- Ingreso con Google (opcional) ----------
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web)
# URI de redirección autorizada: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Datos legales (Libro de Reclamaciones) ----------
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_RUC=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ---------- Envío gratis ----------
# Monto mínimo en soles (0 = desactivado) y departamentos donde aplica
NEXT_PUBLIC_FREE_SHIPPING_FROM=199
NEXT_PUBLIC_FREE_SHIPPING_ZONES=Lima,Callao

# ---------- Correos (constancia y respuesta del Libro de Reclamaciones) ----------
# https://resend.com (plan gratuito). EMAIL_FROM debe ser de tu dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=
